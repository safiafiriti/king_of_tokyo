<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.kingoftokyo.ui.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_rulesFragment"
            app:destination="@id/rulesFragment" />
    </fragment>
    <fragment
        android:id="@+id/playerSetUpFragment"
        android:name="com.example.kingoftokyo.ui.playerSetup.PlayerSetUpFragment"
        android:label="fragment_player_set_up"
        tools:layout="@layout/fragment_player_set_up" >
        <action
            android:id="@+id/action_playerSetUpFragment_to_gameFragment"
            app:destination="@id/gameFragment" />
    </fragment>
    <fragment
        android:id="@+id/rulesFragment"
        android:name="com.example.kingoftokyo.ui.rules.RulesFragment"
        android:label="fragment_rules"
        tools:layout="@layout/fragment_rules" >
        <action
            android:id="@+id/action_rulesFragment_to_playerSetUpFragment"
            app:destination="@id/playerSetUpFragment" />
    </fragment>
    <fragment
        android:id="@+id/lostGameFragment"
        android:name="com.example.kingoftokyo.ui.lostGame.LostGameFragment"
        android:label="fragment_lost_game"
        tools:layout="@layout/fragment_lost_game" >
        <action
            android:id="@+id/action_lostGameFragment_to_playerSetUpFragment"
            app:destination="@id/playerSetUpFragment" />
    </fragment>
    <fragment
        android:id="@+id/wonGameFragment"
        android:name="com.example.kingoftokyo.ui.wonGame.WonGameFragment"
        android:label="fragment_won_game"
        tools:layout="@layout/fragment_won_game" >
        <action
            android:id="@+id/action_wonGameFragment_to_playerSetUpFragment"
            app:destination="@id/playerSetUpFragment" />
    </fragment>
    <fragment
        android:id="@+id/gameFragment"
        android:name="com.example.kingoftokyo.ui.game.GameFragment"
        android:label="fragment_game"
        tools:layout="@layout/fragment_game" >
        <action
            android:id="@+id/action_gameFragment_to_lostGameFragment"
            app:destination="@id/lostGameFragment" />
        <action
            android:id="@+id/action_gameFragment_to_wonGameFragment"
            app:destination="@id/wonGameFragment" />
    </fragment>
    <dialog
        android:id="@+id/powerCardFragment"
        android:name="com.example.kingoftokyo.ui.powerCards.PowerCardFragment"
        android:label="fragment_power_card"
        tools:layout="@layout/fragment_power_card" >

        <action
            android:id="@+id/action_powerCardFragment_to_gameFragment"
            app:destination="@id/gameFragment" />
    </dialog>
</navigation>