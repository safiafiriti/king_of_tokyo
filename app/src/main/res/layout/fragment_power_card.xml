<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <!-- Conteneur de la popup -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/popup_container"
        android:layout_width="0dp"
        android:layout_height="450dp"
        android:layout_margin="60dp"
        android:background="@drawable/bg_powercard_popup"
        android:padding="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Cartes sans titre -->
        <LinearLayout
            android:id="@+id/cards_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/card_image_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/power_focus_card"
                android:layout_marginBottom="20dp"/>

            <ImageView
                android:id="@+id/card_image_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/rage_boost_card"
                android:layout_marginBottom="20dp"/>

            <ImageView
                android:id="@+id/card_image_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/power_focus_card" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttons_container"
            style="?android:attr/buttonBarStyle"
            android:layout_marginTop="20dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/cards_container"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/button_cancel"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textStyle="bold"
                android:backgroundTint="#E7C301"
                android:textColor="#000000"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/button_buy"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/buy"
                android:textStyle="bold"
                android:backgroundTint="#3AC769"
                android:textColor="#000000"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>