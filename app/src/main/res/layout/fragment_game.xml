<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1122"
    tools:context=".ui.game.GameFragment">

    <!-- Top Bar -->
    <View
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#3E254C"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Round Title -->
    <TextView
        android:id="@+id/round_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rounds"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/top_bar"
        app:layout_constraintTop_toTopOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1" />

    <!-- BOUTON CARDS (SHOP) -->
    <Button
        android:id="@+id/shop_button"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#673AB7"
        android:text="Cards"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/top_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_bar" />

    <!-- Players Grid -->
    <GridLayout
        android:id="@+id/players_grid"
        android:layout_width="380dp"
        android:layout_height="334dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:rowCount="2"
        android:useDefaultMargins="false"
        app:layout_constraintBottom_toTopOf="@+id/dice_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        app:layout_constraintVertical_bias="0.0">

        <!-- TOP LEFT: REXMAW -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/reximaw_card" />

            <TextView
                android:id="@+id/rexmaw_tokyo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="荘"
                android:textSize="30sp"
                android:visibility="gone"
                android:layout_gravity="top|start"
                android:padding="4dp"/>

            <LinearLayout
                android:layout_width="42dp"
                android:layout_height="88dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/rexmaw_heart"
                    layout="@layout/view_stat_box_heart" />

                <include
                    android:id="@+id/rexmaw_star"
                    layout="@layout/view_stat_box_star" />
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="8dp" />
                <include
                    android:id="@+id/rexmaw_energy"
                    layout="@layout/view_stat_box_energy" />
            </LinearLayout>
        </FrameLayout>

        <!-- TOP RIGHT: MEKO -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/meko_card" />

            <TextView
                android:id="@+id/meko_tokyo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="荘"
                android:textSize="30sp"
                android:visibility="gone"
                android:layout_gravity="top|start"
                android:padding="4dp"/>

            <LinearLayout
                android:layout_width="42dp"
                android:layout_height="88dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/meko_heart"
                    layout="@layout/view_stat_box_heart" />

                <include
                    android:id="@+id/meko_star"
                    layout="@layout/view_stat_box_star" />
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="8dp" />
                <include
                    android:id="@+id/meko_energy"
                    layout="@layout/view_stat_box_energy" />
            </LinearLayout>
        </FrameLayout>

        <!-- BOTTOM LEFT: GRUMPJAW -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/grumpjaw_card" />

            <TextView
                android:id="@+id/grumJaw_tokyo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="荘"
                android:textSize="30sp"
                android:visibility="gone"
                android:layout_gravity="top|start"
                android:padding="4dp"/>

            <LinearLayout
                android:layout_width="42dp"
                android:layout_height="88dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/grumpJaw_heart"
                    layout="@layout/view_stat_box_heart" />

                <include
                    android:id="@+id/grumpJaw_star"
                    layout="@layout/view_stat_box_star" />
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="8dp" />
                <include
                    android:id="@+id/grumpJaw_energy"
                    layout="@layout/view_stat_box_energy" />
            </LinearLayout>
        </FrameLayout>

        <!-- BOTTOM RIGHT: VENOMJUNCH -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/venomjunch_card" />

            <TextView
                android:id="@+id/venomJunch_tokyo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="荘"
                android:textSize="30sp"
                android:visibility="gone"
                android:layout_gravity="top|start"
                android:padding="4dp"/>

            <LinearLayout
                android:layout_width="42dp"
                android:layout_height="88dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/venomJunch_heart"
                    layout="@layout/view_stat_box_heart" />

                <include
                    android:id="@+id/venomJunch_star"
                    layout="@layout/view_stat_box_star" />
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="8dp" />
                <include
                    android:id="@+id/venomJunch_energy"
                    layout="@layout/view_stat_box_energy" />
            </LinearLayout>
        </FrameLayout>
    </GridLayout>

    <LinearLayout
        android:id="@+id/dice_container"
        android:layout_width="362dp"
        android:layout_height="262dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/white_rounded_bg"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Buttons -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/rollButton"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:backgroundTint="#E7C301"
                android:text="@string/roll"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/validateButton"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:backgroundTint="#3AC769"
                android:text="@string/validate"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- Dice Grid -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dice_grid"
            android:layout_width="307dp"
            android:layout_height="164dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <!-- ROW 1 -->
            <ImageView
                android:id="@+id/dice1"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/dice_bg"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/dice_claw"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/dice2"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/dice_bg"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/dice_energy"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/dice3"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/dice_bg"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/dice_heart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- ROW 2 -->
            <ImageView
                android:id="@+id/dice4"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/dice_bg"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/dice_one"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dice1" />

            <ImageView
                android:id="@+id/dice5"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/dice_bg"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/dice_two"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.502"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dice2" />

            <ImageView
                android:id="@+id/dice6"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/dice_bg"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/dice_three"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dice3" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>